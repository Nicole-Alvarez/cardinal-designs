{
  "name": "cardinal-designs-api",
  "version": "1.0.0",
  "description": "Express + Prisma backend for cardinal-designs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "prisma generate && prisma migrate deploy",
    "dev": "concurrently -k -n api,studio \"tsx watch src/index.ts\" \"prisma studio\"",
    "prebuild": "prisma generate",
    "build": "tsc",
    "prestart": "prisma generate && prisma migrate deploy",
    "start": "node dist/index.js",
    "db:seed": "tsx prisma/seed.ts",
    "studio": "prisma studio"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@vercel/blob": "^2.8.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "concurrently": "^10.0.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
